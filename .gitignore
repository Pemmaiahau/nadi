node_modules/
.next/
out/
build/
.env*.local
.DS_Store
*.log

# Swiss Ephemeris data files: sepl_18.se1 and semo_18.se1 are vendored so that
# deployed builds get full Swiss precision instead of the Moshier fallback.
# Any other .se1 files (asteroids, extended date ranges) stay out of the repo.
ephe/*
!ephe/sepl_18.se1
!ephe/semo_18.se1
